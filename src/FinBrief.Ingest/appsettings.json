{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Groq": {
    "BaseUrl": "https://api.groq.com/openai/v1",
    "Model": "openai/gpt-oss-120b",
    "MaxOutputTokens": 2048,
    "MinSecondsBetweenCalls": 8
  },
  "Ingestion": {
    "MaxAgeHours": 72,
    "Sources": {
      "Economic Times": { "UseImages": true },
      "Livemint": { "UseImages": false }
    },
    "Feeds": [
      { "Source": "Economic Times", "Topic": "markets",           "Category": "markets",        "Url": "https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms" },
      { "Source": "Economic Times", "Topic": "commodities",       "Category": "markets",        "Url": "https://economictimes.indiatimes.com/markets/commodities/rssfeeds/1808152121.cms" },
      { "Source": "Economic Times", "Topic": "economy",           "Category": "economy",        "Url": "https://economictimes.indiatimes.com/news/economy/rssfeeds/1373380680.cms" },
      { "Source": "Economic Times", "Topic": "startups",          "Category": "startups",       "Url": "https://economictimes.indiatimes.com/tech/startups/rssfeeds/78570540.cms" },
      { "Source": "Economic Times", "Topic": "funding",           "Category": "startups",       "Url": "https://economictimes.indiatimes.com/tech/funding/rssfeeds/78570550.cms" },
      { "Source": "Economic Times", "Topic": "banking & finance", "Category": "fintech",        "Url": "https://economictimes.indiatimes.com/industry/banking/finance/rssfeeds/13358259.cms" },
      { "Source": "Economic Times", "Topic": "AI",                "Category": "ai-business",    "Url": "https://economictimes.indiatimes.com/tech/artificial-intelligence/rssfeeds/110870909.cms" },
      { "Source": "Economic Times", "Topic": "world business",    "Category": "global-finance", "Url": "https://economictimes.indiatimes.com/world/business/rssfeeds/134496792.cms" },
      { "Source": "Livemint",       "Topic": "markets",           "Category": "markets",        "Url": "https://www.livemint.com/rss/markets" },
      { "Source": "Livemint",       "Topic": "economy",           "Category": "economy",        "Url": "https://www.livemint.com/rss/economy" },
      { "Source": "Livemint",       "Topic": "money",             "Category": "economy",        "Url": "https://www.livemint.com/rss/money" },
      { "Source": "Livemint",       "Topic": "AI",                "Category": "ai-business",    "Url": "https://www.livemint.com/rss/AI" }
    ]
  }
}
