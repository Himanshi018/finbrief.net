<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FinBrief.Core\FinBrief.Core.csproj" />
    <ProjectReference Include="..\FinBrief.Infrastructure\FinBrief.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Same id as FinBrief.Api, so both apps read the same user-secrets (connection string, Groq key). -->
    <UserSecretsId>0799f371-f471-493e-aa80-17738bc0f5dd</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Console apps don't copy appsettings.json to the output folder by default. -->
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
